# Kopiere diese Datei nach ".env" und trage die echten Werte ein.
# ".env" wird nie eingecheckt (siehe .gitignore) und nie an den Browser ausgeliefert –
# server.js liest sie nur serverseitig und baut daraus den bns_request.

# Basis-URL der BOSYS UI.SPACE Traveller API (Endpunkt für GetReiseData)
BOSYS_GATEWAY_URL=https://example-midoffice.bosys.eu/cgi-bin/uiofficegate.cgi

# Header-Felder aus der API-Doku
BOSYS_SOURCE=e-confirm
BOSYS_TERMINAL=1
BOSYS_TOKEN=

# GetReiseData.sessionID – daraus liest das MidOffice Firma/Büro/Kundennummer
BOSYS_SESSION_ID=

# GetOffice.Token ("Mein Reisebüro") – der sogenannte HashKey. Unabhängig
# von BOSYS_SESSION_ID/travelID; ohne diesen Wert liefert /api/office
# Demo-Reisebüro-Daten.
BOSYS_OFFICE_TOKEN=

# API-Key für "In der Nähe" (Google Places API "New", searchNearby) – zeigt
# Restaurants/Sehenswürdigkeiten rund um das Hotel im Reiseplan. Key in der
# Google Cloud Console anlegen, "Places API (New)" aktivieren, Billing
# einrichten (kostenpflichtig pro Aufruf). Unabhängig von BOSYS; ohne diesen
# Wert liefert /api/places Demo-Orte.
GOOGLE_PLACES_API_KEY=

# Reisebewertung (Projekt "feedback") – nach Reiseende erscheint auf der
# Startseite ein Link zur Bewertung. "{hashKey}" wird durch die travelID
# (= HashKey) der Reise ersetzt. Ohne Platzhalter wird die URL unverändert
# genutzt, z.B. zum lokalen Testen mit festem HashKey:
#   BEWERTUNG_URL=http://localhost:3001/bewertung/vorbei
# Leer = kein Bewertungslink.
BEWERTUNG_URL=http://localhost:3001/bewertung/{hashKey}

# Flugstatus (AeroDataBox) – Live-Status (Verspätung, Terminal, Gate,
# Gepäckband, Annullierung) zu den Flügen im Reiseplan. Abgefragt wird nur
# ab 2 Tage vor bis 1 Tag nach dem Abflugtag, mit Server-Cache pro Flug.
# Ohne Key liefert /api/flugstatus einen Demo-Status.
# Standard: Zugang über RapidAPI (Key aus dem RapidAPI-Dashboard).
AERODATABOX_API_KEY=
# Nur ändern, wenn NICHT über RapidAPI gebucht wurde, z.B. API.Market:
#   AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
#   AERODATABOX_KEY_HEADER=x-api-market-key
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com
AERODATABOX_KEY_HEADER=X-RapidAPI-Key

# WhatsApp-Nummer des Büros für den "Per WhatsApp kontaktieren"-Button in
# "Mein Reisebüro". GetOffice liefert kein eigenes WhatsApp-Feld – ohne
# diesen Wert fällt der Button auf MyOffice.phone zurück (oft eine
# Festnetznummer, nicht zwangsläufig WhatsApp-fähig). Beliebiges gängiges
# Format möglich, z.B. "+49 171 1775434", "00491711775434" oder
# "0171 1775434" – wird clientseitig automatisch normalisiert.
WHATSAPP_OFFICE_NUMBER=

# "Nächste Reise" (siehe TODO.md) – Formular auf der Startseite (nur bei
# beendeten Reisen sichtbar), das Reisewünsche fürs nächste Angebot sammelt.
# NEXT_TRIP_CGI_URL ist der Endpunkt des MidOffice-CGI, an den die Anfrage
# gepusht wird; ohne diesen Wert wird jede Anfrage nur serverseitig geloggt
# (kein Fehler für den Nutzer). NEXT_TRIP_CGI_TOKEN optional, falls das CGI
# ein Bearer-Token zur Authentifizierung verlangt.
NEXT_TRIP_CGI_URL=
NEXT_TRIP_CGI_TOKEN=

# Port, auf dem die App lokal läuft
PORT=3000
