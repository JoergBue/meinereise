# Kopiere diese Datei nach ".env" und trage die echten Werte ein.
# ".env" wird nie eingecheckt (siehe .gitignore) und nie an den Browser ausgeliefert –
# server.js liest sie nur serverseitig und baut daraus den bns_request.

# Basis-URL der BOSYS UI.SPACE Traveller API (Endpunkt für GetReiseData)
BOSYS_GATEWAY_URL=https://example-midoffice.bosys.eu/cgi-bin/uiofficegate.cgi

# Header-Felder aus der API-Doku
BOSYS_SOURCE=e-confirm
BOSYS_TERMINAL=1
BOSYS_TOKEN=

# GetReiseData.sessionID – daraus liest das MidOffice Firma/Büro/Kundennummer
BOSYS_SESSION_ID=

# GetOffice.Token ("Mein Reisebüro") – der sogenannte HashKey. Unabhängig
# von BOSYS_SESSION_ID/travelID; ohne diesen Wert liefert /api/office
# Demo-Reisebüro-Daten.
BOSYS_OFFICE_TOKEN=

# API-Key für "In der Nähe" (Google Places API "New", searchNearby) – zeigt
# Restaurants/Sehenswürdigkeiten rund um das Hotel im Reiseplan. Key in der
# Google Cloud Console anlegen, "Places API (New)" aktivieren, Billing
# einrichten (kostenpflichtig pro Aufruf). Unabhängig von BOSYS; ohne diesen
# Wert liefert /api/places Demo-Orte.
GOOGLE_PLACES_API_KEY=

# Port, auf dem die App lokal läuft
PORT=3000
